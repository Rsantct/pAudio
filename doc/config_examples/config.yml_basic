# Please see doc/ and doc/config_examples for more features or Linux + Jack environment
#
# MORE INFO HERE: https://github.com/HEnquist/camilladsp/blob/master/backend_coreaudio.md
#
coreaudio:

    # DO NOT SPECIFY 'format' nor 'dither' because they are in charge of CoreAudio
    devices:

        capture:

            channels: 2
            device: BlackHole 2ch

        playback:

            channels: 2
            device: Altavoces del MacBook Pro

            # Special note for the Behringer UCA 202 USB sound card
            # NOTICE that the card name has a weird trailing space in CoreAudio
            #device: "USB Audio CODEC "

    # Restore system volume in dB when pAudio is turned off
    restore_volume: -30

loudspeaker: MyLoudspeaker

# Optional settings at startup
on_init:
    keep_muted:         false
    mono:               off
    level:
    lu_offset:          9.0
    equal_loudness:     true
    balance:            0.0
    bass:               0
    treble:             0
    tone_defeat:        false
    target:             +3.0-1.0
    drc_set:            

# Optional web page settings
web_config:

    # ON/OFF button
    # Set 'pAudio' (if using as a desktop app) or 'amplifier' (if a switch is available in a dedicated machine)
    # Default to 'pAudio' if not configured.
    onoff: pAudio

    # Monkey button
    # Set 'toggle' for stop and restart pAudio (in a desktop), or 'restart' to allways restart it (in a dedicated machine)
    # Default to 'toggle' if not configured.
    monkey_button:  toggle

    # HELP button language: en(glish) | sp(panish) | cat(alan)
    help_lang:      en

# 'onoff' user's command or script to toggle the amplifier (optional)
amplifier_switch:
    command:        '~/bin/ampli.sh'
    manage_pAudio:  true
