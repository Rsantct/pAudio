paudio_addr:    0.0.0.0
paudio_port:    9990

samplerate: 48000

# JACK
jack:

    device:         hw:UDJ6,0
    period:         1024
    nperiods:       2
    dither:         true
    softmode:       false
    16bit:          false        # alias of  "shorts:  false"

    sources:
        analog:
            jport:  system

        cd:
            jport:  mpd_loop

        # A remote pAudio native source based on zita-njbridge
        remoteSalon:
            remote_addr:        192.168.1.57
            remote_track_level: true
            # Default is 10 ms, but if you use WiFi you'll need about 100 ms (not recommended)
            zita_buffer_ms:     20
            # Compensation delay is an experimental value that depends
            # on the *zita_buffer* as well on the *jack buffer*.
            # It must be taken by selecting the minimum delay
            # filtering sets available on both ends
            # If the value is negative, it will be applied at the remote end.
            compensation_delay: 12

        # A special remote source based on JackTrip
        MacBook Pro:
            jacktrip: true

    # Optional config for zita-njbridge based multiroom remote sources
    # (default is 65000)
    zita_udp_base:          65000


loudspeaker: SeasFlat

ref_level_gain_offset:  -3.0


plugins:

    - DVB-T.py
    - autoplay_cdda.py
    - autoeject_cdda.py
    - mpd.py
    - spotify_desktop.py    # for more details see inside thep lugin docstring

# optional
expert_zone:

    # Messages will appear in the control web page. Default is true.
    camilladsp_xrun_monitor: true

    # Useful for some use cases as Raspberry Pi 3 and jack backend (cpal), to avoid the CamillaDSP
    # xrun cpal errors when the intermediate cpal layer does not detect camilladsp packets.
    # Default is false. Notice that CPU load will not decrease anymore, so you may
    # consider to include a 'paudio_restart.sh stop' entry in your daily crontab.
    disable_silence_timeout: true
