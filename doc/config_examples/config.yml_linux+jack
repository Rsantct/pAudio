paudio_addr:    0.0.0.0
paudio_port:    9990

samplerate: 48000

# JACK
jack:

    device:         hw:UDJ6,0
    period:         1024
    nperiods:       2
    dither:         true
    sources:
        analog:
            jport:  system

        remoteSalon:
            remote_addr:        192.168.1.57
            remote_delay:       0
            remote_track_level: true

    # Optional config for zita-njbridge based multiroom remote sources
    zita_udp_base:          65000
    zita_buffer_ms:         150


loudspeaker: SeasFlat

ref_level_gain_offset:  -3.0


plugins:

    - DVB-T.py

    - mpd.py

    # With PipeWire, you need to restart Spotify to get it to work through the
    # new instance of PipeWire that was triggered by Jack starting up in pAudio.
    - spotify_desktop.py
