paudio_addr:    0.0.0.0
paudio_port:    9990

samplerate: 48000

# JACK
jack:

    device:         hw:UDJ6,0
    period:         1024
    nperiods:       2
    dither:         true
    softmode:       false
    16bit:          false      # alias of  "shorts:  false"
    io_mode:                   # optional, 'rec', 'play' or 'playrec' (default is autodetected)
    playback_ports:            # optional, default uses all ALSA subdevices, but in some cards
                               # you may want to limit to 2, e.g. RPI 3B+ bcm2835 Headphones

    sources_auto_switch: false

    sources:
        analog:
            jport:  system

        cd:
            jport:  mpd_loop

        # A remote pAudio native source based on zita-njbridge
        remoteSalon:
            remote_addr:            192.168.1.57
            remote_track_level:     true
            zita_buffer_ms:         20
            compensation_delay_ms:  0
            # Zita default is 10 ms, but if you use WiFi (not recommended) you may want > 100 ms
            # Compensation delay is an experimental value that you need to fine tune AFTER setting the zita_buffer,
            # then an internal calculator will order convenient extra_delay commands to both local and remote.
            #     - a positive value will push the calculated extra_delay to the local system,
            #     - a negative value will push it to the remote end.
            # Changes in both ___ms parameters will take effect dynamically when selecting a remote source.
            # The internal calculator takes in account the current DSP latencies at both ends,
            # for instance when selecting linear phase filters.

        # A special remote source based on JackTrip
        MacBook Pro:
            jacktrip: true

    # Optional config for zita-njbridge based multiroom remote sources
    # (default is 65000)
    zita_udp_base:          65000


loudspeaker:         SeasFlat

# Optional for a right channel network slave loudspeaker.
# At least one dedicated network must be available (see bin/paudio_slave_tools)
#     192.168.10.x for Eth
#     192.168.20.x for WiFi
slave_loudspeaker:            # must be 'eth', 'wifi', or void


ref_level_gain_offset:  -3.0


plugins:

    - DVB-T.py
    - autoplay_cdda.py
    - autoeject_cdda.py
    - mpd.py
    - spotify_desktop.py    # for more details see inside thep lugin docstring

# optional
expert_zone:

    # Messages will appear in the control web page. Default is true.
    camilladsp_xrun_monitor: true

    # Useful for some use cases as Raspberry Pi 3 and jack backend (cpal), to avoid the CamillaDSP
    # xrun cpal errors when the intermediate cpal layer does not detect camilladsp packets.
    # Default is false. Notice that CPU load will not decrease anymore, so you may
    # consider to include a 'paudio_restart.sh stop' entry in your daily crontab.
    disable_silence_timeout: true
