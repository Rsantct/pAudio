<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN"
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

    <key>Label</key>
    <string>com.pAudio.ctrl</string>

    <!-- This enables this process to use the session Desktop resources
    -->
    <key>LimitLoadToSessionType</key>
    <array>
            <string>Aqua</string>
            <string>Background</string>
            <string>LoginWindow</string>
            <string>System</string>
            <string>StandardIO</string>
    </array>

    <!-- using a shell to have a full user environment
    -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-l</string>
        <string>-c</string>
        <string>sleep 2 && source $HOME/.env/bin/activate && exec python3 $HOME/pAudio/code/share/server.py paudio_ctrl 0.0.0.0 9991</string>
    </array>

    <!-- run on sesion init -->
    <key>RunAtLoad</key>
    <true/>

    <!-- do not restart if the program is terminated -->
    <key>KeepAlive</key>
    <false/>

    <!-- DEBUG (while testing)
    -->
    <key>StandardOutPath</key>
    <string>/tmp/com.pAudio.ctrl.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/com.pAudio.ctrl.err</string>

</dict>
</plist>
